# Copy to .env and configure ONE AI auth path.

# Option A (legacy GitHub token path; may be unavailable if endpoint is retired)
# Generate from host with: gh auth token
GITHUB_TOKEN=

# Option B (recommended): Azure Foundry / Azure OpenAI compatible endpoint
# Example endpoint:
#   WHATIDID_API_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions
# Example model/deployment name:
#   WHATIDID_MODEL=gpt-5.4
# For Azure-style auth header, keep WHATIDID_API_AUTH=api-key and set key below.
WHATIDID_API_URL=
WHATIDID_MODEL=gpt-5.4
WHATIDID_API_KEY=
WHATIDID_API_AUTH=api-key
# Optional for Azure endpoints that require it (example: 2024-10-21)
WHATIDID_API_VERSION=

# Optional concurrency override.
WHATIDID_ANALYZE_WORKERS=5
